# Copy this file to mobile.dart-defines.ps1.local, replace placeholders,
# then run:
#   . .\app\secrets\mobile.dart-defines.ps1.local
#   flutter run $env:PRICER_MOBILE_DART_DEFINES

$env:PRICER_MOBILE_DART_DEFINES = @(
  '--dart-define=PRICER_API_BASE_URL=https://europe-west1-pricer-ee440.cloudfunctions.net/api'
  '--dart-define=REVENUECAT_ANDROID_API_KEY=replace_me'
  '--dart-define=REVENUECAT_IOS_API_KEY=replace_me'
  '--dart-define=REVENUECAT_ENTITLEMENT_ID=premium'
  '--dart-define=ADMOB_ANDROID_APP_ID=ca-app-pub-replace-me'
  '--dart-define=ADMOB_IOS_APP_ID=ca-app-pub-replace-me'
  '--dart-define=ADMOB_BANNER_ANDROID_UNIT_ID=ca-app-pub-replace-me/replace-me'
  '--dart-define=ADMOB_BANNER_IOS_UNIT_ID=ca-app-pub-replace-me/replace-me'
  '--dart-define=ADMOB_INTERSTITIAL_ANDROID_UNIT_ID=ca-app-pub-replace-me/replace-me'
  '--dart-define=ADMOB_INTERSTITIAL_IOS_UNIT_ID=ca-app-pub-replace-me/replace-me'
) -join ' '
