# Copy this file to backend.env.local and fill only the values you need.
# Files in this folder are ignored by app/secrets/.gitignore unless they end with .example.

# Local backend mode examples:
PRICER_STORE_BACKEND=json
# PRICER_STATE_FILE=C:\dev\Pricer\runtime_data\state.json

# Firestore runtime examples:
# PRICER_STORE_BACKEND=firestore
# PRICER_FIRESTORE_COLLECTION_PREFIX=dev
# PRICER_FIRESTORE_PROJECT_ID=pricer-ee440
# PRICER_FIRESTORE_DATABASE_ID=(default)
# PRICER_FIRESTORE_APP_NAME=pricer-backend-store
# Functions deploy region should be europe-west1.

# Location-aware search rollout:
# Safe default is provider_only. Set reviewed_first only after Phase 2K diagnostics pass rollout criteria.
# DEFAULT_COORDINATE_MODE=provider_only

# Temporary Phase 20 internal analytics guard:
# Required for /analytics/gap-detection, /analytics/opportunities, and /analytics/insights/*.
# Requests must send x-pricer-admin-token with this value and x-pricer-role=admin or analyst.
# PRICER_INTERNAL_ANALYTICS_TOKEN=replace_me

# Local Postgres sidecar examples for DB1+ jobs:
# Start with: docker compose up -d postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=pricer_dev
# POSTGRES_USER=pricer
# POSTGRES_PASSWORD=pricer_dev_password
# POSTGRES_SSL=false
# Or use DATABASE_URL=postgres://pricer:pricer_dev_password@localhost:5433/pricer_dev

# AI services:
ENABLE_LLM_ENRICHMENT=true
# Intended runtime default is true. Live calls still require XAI_API_KEY.
# XAI_API_KEY=replace_me
# XAI_GROK_MODEL=grok-3-mini
# XAI_EMBEDDING_MODEL=text-embedding-model

# FCM:
# FIREBASE_PROJECT_ID=pricer-ee440
# FCM_ACCESS_TOKEN=replace_me

# Local ADC path when needed outside deployed GCP/Firebase:
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\pricer-service-account.json
